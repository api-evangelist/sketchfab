{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sketchfab Data Orgs API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://sketchfab.com/oauth2/authorize/",
      "accessTokenUrl": "https://sketchfab.com/oauth2/token/",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Orgs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve An Organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sketchfab.com/v3/orgs/:org",
            "params": [
              {
                "name": "org",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get organization detail, including plan and member count, for organizations the caller belongs to."
        },
        {
          "info": {
            "name": "List Organization Projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sketchfab.com/v3/orgs/:org/projects",
            "params": [
              {
                "name": "org",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List projects (workspaces) within an organization."
        }
      ]
    }
  ],
  "bundled": true
}