{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sketchfab Data Bookmarks API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://sketchfab.com/oauth2/authorize/",
      "accessTokenUrl": "https://sketchfab.com/oauth2/token/",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Bookmarks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List My Bookmarks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sketchfab.com/v3/me/bookmarks"
          },
          "docs": "Retrieve the authenticated user's bookmarked models."
        }
      ]
    }
  ],
  "bundled": true
}