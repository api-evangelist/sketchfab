{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sketchfab Data Collections API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://sketchfab.com/oauth2/authorize/",
      "accessTokenUrl": "https://sketchfab.com/oauth2/token/",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Collections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Collections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sketchfab.com/v3/collections",
            "params": [
              {
                "name": "user",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List collections for the authenticated user or for the user filter."
        },
        {
          "info": {
            "name": "Create A Collection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sketchfab.com/v3/collections",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new collection of models."
        },
        {
          "info": {
            "name": "Add A Model To A Collection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sketchfab.com/v3/collections/:uid/models",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a model to the specified collection."
        }
      ]
    }
  ],
  "bundled": true
}