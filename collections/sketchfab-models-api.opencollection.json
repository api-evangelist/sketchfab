{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sketchfab Data Models API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://sketchfab.com/oauth2/authorize/",
      "accessTokenUrl": "https://sketchfab.com/oauth2/token/",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search 3D Models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sketchfab.com/v3/models",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Full-text search query."
              },
              {
                "name": "tags",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of tag slugs."
              },
              {
                "name": "categories",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of category slugs."
              },
              {
                "name": "downloadable",
                "value": "",
                "type": "query",
                "description": "Restrict to downloadable models."
              },
              {
                "name": "license",
                "value": "",
                "type": "query",
                "description": "License filter (e.g. by, by-sa, cc0, ed, st)."
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query",
                "description": "Sort order (-publishedAt, -likeCount, -viewCount, -processedAt)."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Pagination cursor returned by previous response."
              }
            ]
          },
          "docs": "Search the public catalog of 3D models with full-text query, tags, categories, license, downloadable filter, and sort options."
        },
        {
          "info": {
            "name": "Upload A Model",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sketchfab.com/v3/models",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "modelFile",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "name",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "description",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "tags",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "categories",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "license",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "private",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "password",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "isPublished",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "source",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Create a new model from an uploaded 3D asset. Send multipart/form-data with the model file and metadata fields. Returns a model uid that can be polled until processing completes."
        },
        {
          "info": {
            "name": "Retrieve A Model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sketchfab.com/v3/models/:uid",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "Sketchfab model UID (hex string in the URL after /models/)."
              }
            ]
          },
          "docs": "Get the public detail record for a single model — metadata, viewer URL, embed URL, thumbnails, and download availability."
        },
        {
          "info": {
            "name": "Update A Model",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.sketchfab.com/v3/models/:uid",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "Sketchfab model UID (hex string in the URL after /models/)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update editable fields on a model owned by the authenticated user (name, description, tags, categories, license, private flag, password, publish state)."
        },
        {
          "info": {
            "name": "Delete A Model",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.sketchfab.com/v3/models/:uid",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "Sketchfab model UID (hex string in the URL after /models/)."
              }
            ]
          },
          "docs": "Permanently delete a model owned by the authenticated user."
        }
      ]
    }
  ],
  "bundled": true
}