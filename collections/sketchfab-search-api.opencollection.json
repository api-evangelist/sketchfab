{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sketchfab Data Search API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://sketchfab.com/oauth2/authorize/",
      "accessTokenUrl": "https://sketchfab.com/oauth2/token/",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search 3D Models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sketchfab.com/v3/models",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Full-text search query."
              },
              {
                "name": "tags",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of tag slugs."
              },
              {
                "name": "categories",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of category slugs."
              },
              {
                "name": "downloadable",
                "value": "",
                "type": "query",
                "description": "Restrict to downloadable models."
              },
              {
                "name": "license",
                "value": "",
                "type": "query",
                "description": "License filter (e.g. by, by-sa, cc0, ed, st)."
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query",
                "description": "Sort order (-publishedAt, -likeCount, -viewCount, -processedAt)."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Pagination cursor returned by previous response."
              }
            ]
          },
          "docs": "Search the public catalog of 3D models with full-text query, tags, categories, license, downloadable filter, and sort options."
        },
        {
          "info": {
            "name": "Search Sketchfab",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sketchfab.com/v3/search",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "One of `models`, `collections`, or `users`."
              },
              {
                "name": "q",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Unified search across models, collections, and users with a `type` selector."
        }
      ]
    }
  ],
  "bundled": true
}