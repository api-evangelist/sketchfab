{
  "info": {
    "_postman_id": "64b8680c-e753-47dd-88e5-85fa6e1106cc",
    "name": "Sketchfab Download OAuth API",
    "description": "Programmatic download of downloadable Sketchfab models in glTF, GLB, and USDZ formats. The endpoint returns short-lived signed URLs for each available format. The caller must be authenticated on behalf of an end user (OAuth Authorization Code or Implicit flow); application-level downloads without user authentication require a direct contract with Sketchfab. Source formats (FBX, OBJ) are not exposed.\n\n\nContact Support:\n Name: Sketchfab Developer Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T11:03:40.000Z",
    "updatedAt": "2026-07-28T11:03:40.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-64b8680c-e753-47dd-88e5-85fa6e1106cc"
  },
